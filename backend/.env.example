PORT=4000

# MongoDB connection string — choose one option:
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/papertrail?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/papertrail
MONGODB_URI=mongodb://localhost:27017/papertrail

JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

ADMIN_SECRET=change_this_admin_secret_in_production

NODE_ENV=development
